# Kopieren nach .env und bei Bedarf anpassen. .env ist gitignored.

# Pfad zur Fotobibliothek
FOTOVIEWER_IMAGES_PATH=

# Ablageort der Embedding-Indizes
FOTOVIEWER_INDEX_DIR=../indices

# Modell für Text-/Bildsuche (siehe README.md > Modelle)
FOTOVIEWER_EMBEDDING_MODEL_NAME=google/siglip2-base-patch16-224

# Modell für Objekterkennung (siehe README.md > Modelle)
FOTOVIEWER_DETECTION_MODEL_NAME=PekingU/rtdetr_r50vd

# Schwellwert für Individuen-Wiedererkennung (siehe README.md > Bekannte Einschränkungen)
FOTOVIEWER_IDENTITY_MATCH_THRESHOLD=0.75

# "cuda" oder "cpu" erzwingen; leer lassen für automatische Erkennung
FOTOVIEWER_DEVICE=

# Ablageort für den Hugging-Face-Modell-Cache (Standard: ~/.cache/huggingface).
# Auf ein Laufwerk mit ausreichend Speicherplatz legen — die Modelle summieren
# sich auf mehrere GB.
HF_HOME=
