# Copy to .env and adjust as needed. .env is gitignored.

# Path to the photo library (required, no default — the app does not start
# without a value)
FOTOVIEWER_IMAGES_PATH=

# Where the embedding indices are stored
FOTOVIEWER_INDEX_DIR=../indices

# Model for text/image search (see README.md > Models)
FOTOVIEWER_EMBEDDING_MODEL_NAME=google/siglip2-base-patch16-224

# Model for object detection (see README.md > Models)
FOTOVIEWER_DETECTION_MODEL_NAME=PekingU/rtdetr_r50vd

# Threshold for recognizing individuals (see README.md > Known limitations)
FOTOVIEWER_IDENTITY_MATCH_THRESHOLD=0.75

# Threshold for duplicate detection on /duplicates
FOTOVIEWER_DUPLICATE_MATCH_THRESHOLD=0.95

# Minimum score for RT-DETR to report a detection
FOTOVIEWER_DETECTION_THRESHOLD=0.7

# UI language: "en" (default) or "de"
FOTOVIEWER_LANGUAGE=en

# Force "cuda" or "cpu"; leave empty for automatic detection
FOTOVIEWER_DEVICE=

# Location of the Hugging Face model cache (default: ~/.cache/huggingface).
# Put it on a drive with enough space — the models add up to several GB.
HF_HOME=
